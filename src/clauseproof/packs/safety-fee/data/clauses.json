{
  "clauses": [
    {
      "clause_id": "contract.accrual",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 计提机制",
      "text": "by_output（产量×单价）/ by_revenue_tiered（超额累退）/ by_revenue_rate（单一比例）/ by_project_cost（工程造价比例）；标准值全部读规则包，金额 Decimal 精确到分。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.basis",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 依据选择",
      "text": "第五十二条跨行业（能分别核算分别提，否则按占比最高业务对合计计提取）；第五十三条净额口径（外购成本 > 营业收入 85% 可按净额）；矿井多种灾害并存从高提取。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.diff",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 双版本对照",
      "text": "按 (industry_id, variant_id) 配对，四类差异（value_changed / rate_changed / added / removed）；两版都登记的行业即使无数值差异也记已比对。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.gate",
      "effective": null,
      "expires": null,
      "path": "数据契约 / status 门控",
      "text": "按计算路径分作用域（calc / check / progress）；status != verified 的条目绝不进入计算路径（来源 rc 1）；input_required 放行但运行时必索，缺失即 rc 2。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.input",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 输入契约",
      "text": "subject = {case_id, profile, ledger?, progress?, compare?}；企业档案缺必填字段即退出码 2；判定内核零文件 IO、零时钟、零环境变量。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.not_assessed",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 未评估",
      "text": "支出无可适用条目 → 未评估（不冒充符合，也不冒充不符合）；引用未评估的条目不得作为合规结论。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.progress",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 使用进度",
      "text": "门槛值来自规则包（2022 版第五十一条 60%）；当年实际使用不足门槛须披露并于下一年度 4 月底前提交书面说明。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.rules",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 规则包纪律",
      "text": "按 依据文件 × 版本 组织；每条挂文号/条款号与 status（verified / pending / input_required），规则包 manifest 逐文件登记 sha256；被手改即规则包不可用。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.spending",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 支出范围四态",
      "text": "符合 / 部分符合 / 不符合 / 不适用；无适用条目记未评估（绝不输出符合）；不适用只保留给原文明确写了例外情形的项。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.summary",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 汇总语义",
      "text": "任一阻断（门控拦截 / 支出红线）→ 退出码 1；否则 0。使用进度披露义务属非阻断结论（与来源 progress 命令 rc 0 一致），在账本消息明示。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.tiered",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 超额累退边界",
      "text": "段区间 [lower, upper)，恰好等于分段点归下一段；逐段量化到分后求和（不是总额乘单一费率）。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.units",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 单位换算",
      "text": "单位定义是定义性事实（1 万元 = 10000 元），不是政策数值；单位不一致可精确换算时换算并记 warning，不可判定即 rc 2，绝不静默猜测。",
      "version": "2026-10-14"
    },
    {
      "clause_id": "contract.version",
      "effective": null,
      "expires": null,
      "path": "数据契约 / 版本锚定",
      "text": "条文库坐标 = 依据基准日 2026-10-14；条文库版本不符即契约违约（退出码 3）。",
      "version": "2026-10-14"
    },
